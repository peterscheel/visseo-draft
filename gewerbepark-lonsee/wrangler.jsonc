{
  // Name muss exakt dem Worker-Namen in Cloudflare entsprechen
  "name": "visseo-draft",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Variablen aus dem Dashboard (CONTACT_TO, CONTACT_FROM) beim Deploy nicht überschreiben
  "keep_vars": true
}
